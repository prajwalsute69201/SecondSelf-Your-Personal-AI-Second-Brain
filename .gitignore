# Virtual environment
.venv/
venv/
ENV/

# Environment secrets & local config
.env
*.env
.env.local
.streamlit/secrets.toml
.streamlit/credentials.toml

# Personal knowledge-base captures & notes (Private Data)
raw/*
!raw/.gitkeep

wiki/Projects/*
!wiki/Projects/.gitkeep
wiki/Areas/*
!wiki/Areas/.gitkeep
wiki/Resources/*
!wiki/Resources/.gitkeep
wiki/Archives/*
