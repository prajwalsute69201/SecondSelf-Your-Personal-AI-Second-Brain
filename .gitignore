# Generated embeddings and index state
data/embeddings.pkl
data/index.json
data/graph.json
!data/.gitkeep

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Operating system & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
