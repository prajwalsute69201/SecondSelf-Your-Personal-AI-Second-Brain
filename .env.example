# ==============================================================================
# SecondSelf — Master Environment Configuration Template (.env.example)
#
# Production Deployment (Vercel):
# - Configure secrets in Vercel Dashboard: Project Settings -> Environment Variables
# - Or set via Vercel CLI:
#     vercel env add GROQ_API_KEY production
#     vercel env add GROQ_API_KEY preview
# - Pull variables to local machine:
#     vercel env pull .env.local
#
# Local Development:
# 1. Copy this file to '.env.local':
#    cp .env.example .env.local
# 2. Add your private credentials (e.g., GROQ_API_KEY starting with 'gsk_').
# 3. NEVER commit '.env', '.env.local', or real credentials to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Application & Deployment Target
# ------------------------------------------------------------------------------
# Target environment: 'local', 'test', 'preview', 'staging', or 'production'
# Type: string (enum: local | test | preview | staging | production)
# Default: local (set to 'production' on Vercel Production deployment)
ENVIRONMENT=local

# Verbose diagnostic tracing toggle
# Type: boolean (true | false)
# Default: false
DEBUG=false

# Standard application logging threshold
# Type: string (enum: DEBUG | INFO | WARNING | ERROR | CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Groq LLM Inference API Configuration (Serverless Synthesis & Classifier)
# ------------------------------------------------------------------------------
# Your private Groq Cloud API Key (obtain from https://console.groq.com/keys)
# REQUIRED in 'preview', 'staging', and 'production'. Must start with 'gsk_'
# On Vercel: Mark this variable as "Secret" / Sensitive (Write-only).
# Type: secret string
# Default: none
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM model for conversational RAG question synthesis in api/ask.py
# Type: string
# Default: llama-3.3-70b-versatile (alternative: llama-3.1-8b-instant)
GROQ_SYNTHESIS_MODEL=llama-3.3-70b-versatile

# LLM model for autonomous PARA classification (offline build plane)
# Type: string
# Default: llama-3.3-70b-versatile
GROQ_CLASSIFY_MODEL=llama-3.3-70b-versatile

# Client HTTP request timeout ceiling in seconds for Groq calls
# Type: float
# Default: 15.0
GROQ_TIMEOUT_SECONDS=15.0

# Maximum exponential backoff retries on transient rate limits (HTTP 429)
# Type: integer
# Default: 3
GROQ_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 3. Serverless Function & CORS Configuration (Vercel Lambda api/ask.py)
# ------------------------------------------------------------------------------
# Comma-separated list of permitted CORS origins for /api/ask
# Use specific domains in production (e.g., https://secondself.vercel.app)
# Type: string (comma-separated origins)
# Default: *
CORS_ORIGINS=*

# In-memory index caching across warm serverless function invocations
# Type: boolean (true | false)
# Default: true
SERVERLESS_CACHE_ENABLED=true

# ------------------------------------------------------------------------------
# 4. Retrieval-Augmented Generation (RAG) Defaults
# ------------------------------------------------------------------------------
# Minimum cosine similarity required for a note to be cited in an AI answer
# Range: 0.0 to 1.0 (Higher = fewer, strictly relevant notes)
# Type: float
# Default: 0.35
RAG_MIN_SCORE=0.35

# Maximum candidate notes retrieved and injected into the LLM context
# Range: 1 to 20
# Type: integer
# Default: 5
RAG_TOP_K=5

# Maximum character budget allocated to assembled corpus context
# Range: 500 to 32000
# Type: integer
# Default: 8000
ASK_MAX_CONTEXT_CHARS=8000

# ------------------------------------------------------------------------------
# 5. Vector Embeddings & Graph Auto-Linking (Local Build Plane)
# ------------------------------------------------------------------------------
# HuggingFace model identifier for generating dense embeddings (384 dimensions)
# NOTE: Precomputed during local build; NOT loaded inside Vercel serverless lambda!
# Type: string
# Default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding vector dimensionality
# Type: integer
# Default: 384
EMBEDDING_DIMENSIONS=384

# Minimum cosine similarity threshold required to automatically inject [[wikilinks]]
# Range: 0.0 to 1.0
# Type: float
# Default: 0.65
SIMILARITY_THRESHOLD=0.65

# Maximum number of reciprocal [[wikilinks]] injected per markdown note
# Range: 1 to 20
# Type: integer
# Default: 5
TOP_K_LINKS=5
