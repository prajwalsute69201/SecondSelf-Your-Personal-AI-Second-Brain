# ==============================================================================
# SecondSelf — Test Environment Configuration (.env.test)
# Committed to version control. Used automatically when ENVIRONMENT=test.
# Uses deterministic mock credentials and strict limits.
# ==============================================================================
ENVIRONMENT=test
DEBUG=true
LOG_LEVEL=DEBUG

GROQ_API_KEY=mock_test_key_00000000000000000000000000000000
GROQ_CLASSIFY_MODEL=llama-3.1-8b-instant
GROQ_SYNTHESIS_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=5.0
GROQ_MAX_RETRIES=1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
SIMILARITY_THRESHOLD=0.65
TOP_K_LINKS=3
RAG_MIN_SCORE=0.40
RAG_TOP_K=3

CORS_ORIGINS=*
SERVERLESS_CACHE_ENABLED=false
